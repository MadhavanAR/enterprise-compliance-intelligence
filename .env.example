# ==============================================================================
# Enterprise Compliance Intelligence (ECI) — Environment Configuration
# ==============================================================================
# Copy this file to .env for local runtime or configure these in your host dashboard
# (e.g. Render, Railway, Vercel). NEVER commit real keys or .env to version control.

# ------------------------------------------------------------------------------
# 1. VECTOR DATABASE (Qdrant)
# ------------------------------------------------------------------------------
# For local embedded storage:
#   QDRANT_URL=.qdrant_local
# For local Qdrant server container:
#   QDRANT_URL=http://localhost:6333
# For Qdrant Cloud (Production):
#   QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
#   QDRANT_API_KEY=your-qdrant-cloud-api-key
QDRANT_URL=.qdrant_local
QDRANT_API_KEY=
COLLECTION_NAME=demo_chunks

# ------------------------------------------------------------------------------
# 2. LLM INFERENCE (Ollama or OpenAI-Compatible Hosted Inference)
# ------------------------------------------------------------------------------
# For local Ollama:
#   OLLAMA_URL=http://localhost:11434/api/generate
# For containerized host reaching local machine:
#   OLLAMA_URL=http://host.docker.internal:11434/api/generate
# For hosted cloud Ollama or GPU instance:
#   OLLAMA_URL=https://ollama.your-domain.com/api/generate
#   OLLAMA_API_KEY=your-optional-bearer-token
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3:latest
OLLAMA_API_KEY=

# LLM Generation parameters
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=180

# ------------------------------------------------------------------------------
# 3. EMBEDDINGS & RETRIEVAL
# ------------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=5
USE_RERANK=true
CONTEXT_LIMIT=2

# Optional Cohere Reranker API key (if unset, deterministic score fallback is used)
COHERE_API_KEY=

# ------------------------------------------------------------------------------
# 4. API SECURITY & ADMINISTRATIVE ACCESS
# ------------------------------------------------------------------------------
# Administrative key for /api/v1/documents/ingest (leave blank to disable upload endpoints)
ADMIN_API_KEY=replace-with-secure-random-admin-secret-token

# Read-only mode: set to 'true' in production to forbid corpus mutations completely
READ_ONLY_MODE=false

# Rate limiting per client IP per minute
RATE_LIMIT_PER_MINUTE=60

# Allowed CORS origins (comma-separated, e.g. "http://localhost:3000,https://my-app.vercel.app")
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 5. OBSERVABILITY & TELEMETRY
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
ENABLE_STRUCTURED_LOGS=true
LOG_TRACE_IDS=true
LOG_LATENCIES=true
LOG_TOKEN_USAGE=true
