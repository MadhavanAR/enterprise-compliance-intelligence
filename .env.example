# RAG Platform Environment Variables
# Copy this to .env and fill in your values

# Vector Database
QDRANT_URL=http://localhost:6333

# LLM Configuration (Local - Ollama)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2:latest

# Optional: Override config.yaml settings
# LLM_TEMPERATURE=0
# LLM_MAX_TOKENS=2048

# Retrieval Configuration
# TOP_K=5
# USE_RERANK=true
# CONTEXT_LIMIT=2

# Optional: Reranking (Cohere API)
# COHERE_API_KEY=your-cohere-api-key-here

# Observability
# LOG_LEVEL=INFO
# LOG_TRACE_IDS=true
# LOG_LATENCIES=true
# LOG_TOKEN_USAGE=true

# Vector Database Collection
# COLLECTION_NAME=demo_chunks
